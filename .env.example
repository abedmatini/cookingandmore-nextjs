# Cloudflare Turnstile. Replace each placeholder with the key from the Turnstile widget.
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Mailbox password for welcome@cookingandmore.de. The contact form sends through IONOS SMTP.
SMTP_PASSWORD=your_mailbox_password
